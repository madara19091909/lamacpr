rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024 && isImage();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // صور الأوسمة والتوثيق: يرفعها المشرف فقط ولا يستطيع العضو استبدال هويته بنفسه.
    match /identity/{adminUid}/{targetUid}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && request.auth.uid == adminUid
        && request.resource.size < 5 * 1024 * 1024 && isImage();
      allow delete: if isAdmin() && request.auth.uid == adminUid;
    }

    match /posts/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024 && isImage();
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
